      t: "`$NUMBER`"
    }
    data: {
      h: "Data"
      n: "data"
      r: false
      sh: "Array of close-approach records"
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    fields: {
      h: "Fields"
